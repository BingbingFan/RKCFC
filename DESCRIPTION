Package: RKCFC
Type: Package
Title: Robust K-Centers Functional Clustering for Sparsely Observed Longitudinal Data
Version: 0.2.0
Authors@R: c(
    person(given = "Bingbing", family = "Fan", role = c("aut", "cre"),
