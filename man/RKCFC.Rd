            breaks = seq(interval[1], interval[2], length.out = 11))
)

fit <- RKCFC(data = pbc, id = "id", ys = "serBilir", timevar = "year",
             K = 2, robust = TRUE, optns = optns,
             init.method = "two-staged", parallel = FALSE, LOO = FALSE)
